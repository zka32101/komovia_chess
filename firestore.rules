rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // Helper Functions
    // ============================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ============================================
    // Users Collection
    // ============================================

    match /users/{userId} {
      // ✅ ユーザーは自分のデータを読み書き可能
      allow read, write: if isOwner(userId);

      // ✅ Admin はすべてのユーザーデータを読み取り可能
      allow read: if isAdmin();

      // ✅ 削除は本人またはadminのみ
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ============================================
    // Security Audit Collection (監査ログ)
    // ============================================

    match /security_audit/{document=**} {
      // ✅ Admin のみ読み取り可能
      allow read: if isAdmin();

      // ✅ システムのみ追記可能
      allow create: if isSignedIn();

      // ✅ 監査ログは削除・更新禁止 (追記のみ)
      allow update, delete: if false;
    }

    // ============================================
    // Compliance Collection (GDPR)
    // ============================================

    match /compliance/{document=**} {
      // ✅ Admin のみ読み取り可能
      allow read: if isAdmin();

      // ✅ 認証ユーザーは自分のデータリクエストのみ作成可能
      allow create: if isSignedIn();

      // ✅ Admin のみ更新・削除可能
      allow update, delete: if isAdmin();
    }

    // ============================================
    // Rankings Collection
    // ============================================

    match /rankings/{document=**} {
      // ✅ 誰でも読み取り可能 (ランキングは公開)
      allow read: if true;

      // ✅ システムのみ書き込み可能
      allow write: if false;
    }

    // ============================================
    // Security Audit & Public Collections
    // ============================================

    match /translations/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /exchange_rates/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================
    // Default Deny (セキュリティ第一)
    // ============================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
