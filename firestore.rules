rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // Helper Functions
    // ============================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function unchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    function onlyChanged(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function isParticipant(ids) {
      return isSignedIn() && request.auth.uid in ids;
    }

    // The other party in a 2-person participant list (message_threads'
    // participantUids is always exactly 2 fixed uids - see its own match
    // block below).
    function otherParticipant(ids, uid) {
      return ids[0] == uid ? ids[1] : ids[0];
    }

    // Reads an int field from the document as it stood before this write,
    // defaulting to 0 both when the document doesn't exist yet (a create)
    // and when the field itself wasn't an int before (defensive) - used to
    // bound a counter's per-write delta on a `set()`-based collection
    // (challenge_streaks), where there's no prior `update()` to diff
    // against the way `onlyChanged` does.
    function prevIntField(field) {
      return resource != null && resource.data[field] is int
        ? resource.data[field] : 0;
    }

    // ============================================
    // Users Collection
    // ============================================

    match /users/{userId} {
      // ✅ ユーザーは自分のデータを読み書き可能
      allow read, write: if isOwner(userId);

      // ✅ Admin はすべてのユーザーデータを読み取り可能
      allow read: if isAdmin();

      // ✅ 削除は本人またはadminのみ
      allow delete: if isOwner(userId) || isAdmin();

      // Cross-user: OnlineGameService._endGameWithResult persists the
      // new onlineRating, plus the shared wins/losses/draws/gamesPlayed
      // stat fields (the same ones CpuGameProvider increments for CPU
      // games - AchievementService reads `wins` off this doc), to BOTH
      // participants when a game ends, so the caller (whichever
      // participant's resign/draw/timeout/forfeit action triggered
      // completion) is often not `userId` itself - same client-trusted
      // pattern this app already uses for other self-reported game
      // outcomes, narrowed to just these fields so nothing else about
      // another user's document can be touched this way.
      //
      // Previously this had no further shape requirement, so any
      // signed-in stranger (not just a real opponent) could call
      // `users/{victim}.update({onlineRating: 0, losses: 999999})`
      // directly with no game in common at all - pure griefing/
      // leaderboard manipulation. Now requires this to look like exactly
      // one real game's worth of bookkeeping: gamesPlayed increases by
      // exactly 1, exactly one of wins/losses/draws increases by exactly
      // 1 (the others, if present at all, unchanged), and onlineRating
      // moves by a bounded amount in one call (±64 covers this app's own
      // K-factor-based rating-system.js/rating_calculator.dart output
      // with headroom; a legitimate single game can never swing a rating
      // further than that).
      allow update: if isSignedIn() &&
        onlyChanged(['onlineRating', 'wins', 'losses', 'draws', 'gamesPlayed']) &&
        request.resource.data.gamesPlayed == resource.data.gamesPlayed + 1 &&
        (request.resource.data.onlineRating - resource.data.get('onlineRating', 0)) >= -64 &&
        (request.resource.data.onlineRating - resource.data.get('onlineRating', 0)) <= 64 &&
        (
          (request.resource.data.get('wins', 0) == resource.data.get('wins', 0) + 1 &&
            request.resource.data.get('losses', 0) == resource.data.get('losses', 0) &&
            request.resource.data.get('draws', 0) == resource.data.get('draws', 0)) ||
          (request.resource.data.get('losses', 0) == resource.data.get('losses', 0) + 1 &&
            request.resource.data.get('wins', 0) == resource.data.get('wins', 0) &&
            request.resource.data.get('draws', 0) == resource.data.get('draws', 0)) ||
          (request.resource.data.get('draws', 0) == resource.data.get('draws', 0) + 1 &&
            request.resource.data.get('wins', 0) == resource.data.get('wins', 0) &&
            request.resource.data.get('losses', 0) == resource.data.get('losses', 0))
        );

      // ----------------------------------------------
      // Friendships (users/{uid}/friends/{friendUid})
      // ----------------------------------------------
      // `FriendService` denormalizes a relationship onto BOTH sides' own
      // `friends` subcollection in one batch (sendFriendRequest,
      // acceptFriendRequest, blockFriend, ...), so a user must also be able
      // to touch their OWN mirror entry (friendUid == caller) inside
      // another user's list. Kept narrow: a new entry must be a pending
      // request that points back at the caller and records who sent it, an
      // existing entry may only move to accepted/blocked (and only the side
      // that did NOT send the request can accept it), and the caller may
      // always remove their own mirror (covers decline/cancel/unfriend/
      // undoing a block mirror on unblockFriend — see FriendService).
      match /friends/{friendUid} {
        allow read: if isOwner(userId);
        allow create: if isOwner(friendUid) &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.status == 'pending' &&
          request.resource.data.requestedBy == request.auth.uid;
        allow update: if isOwner(friendUid) &&
          unchanged('uid') &&
          onlyChanged(['status', 'blockedBy']) &&
          (
            request.resource.data.status == 'blocked' ||
            (request.resource.data.status == 'accepted' &&
              resource.data.get('requestedBy', null) != request.auth.uid)
          );
        allow delete: if isOwner(friendUid);
      }

      // Cross-user: a friend-request/accept notification is written into
      // the OTHER party's inbox by `FriendService`
      // (sendFriendRequest/acceptFriendRequest), and a rematch
      // notification by `OnlineGameService`
      // (notifyOpponentOfRematch) - request.auth.uid is therefore
      // never necessarily `userId` here by design. Previously this had
      // no restriction at all beyond "doc id matches the path", so any
      // signed-in stranger could flood any victim's inbox with
      // completely attacker-controlled title/body/type and an
      // arbitrary data.actionUrl (a phishing-style deep link, since
      // NotificationScreen navigates to whatever actionUrl a
      // notification carries). Restricting `type` to the two values
      // this app actually ever sends, and `data.actionUrl` to the
      // shape those two send, closes the spam/phishing vector without
      // needing a full sender-relationship check (friend_request's
      // sender and the recipient aren't friends yet at send time, so
      // "must already be an accepted friend" wouldn't even fit the
      // legitimate case).
      match /notifications/{notificationId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if isSignedIn() &&
          request.resource.data.uid == userId &&
          request.resource.data.type in [
            'friend_request', 'game_matched',
            'challenge_received', 'challenge_accepted', 'challenge_declined'
          ] &&
          request.resource.data.data.actionUrl.matches('^/(friends|challenges|online-game/.+)$');
      }

      // Per-user progress against the app's bundled static curriculum
      // content (ChessLessonsService) - entirely private, never read by
      // anyone but the owner.
      match /lesson_progress/{lessonKey} {
        allow read, write: if isOwner(userId);
      }
    }

    // ============================================
    // User Preferences (user_preferences_provider.dart / sound_preferences_provider.dart)
    // ============================================
    // Keyed by uid directly (not nested under users/{uid}), so it needs
    // its own top-level block. Had no rule at all before this, so every
    // write (theme/language/board style/sound toggles, etc.) from
    // SettingsScreen/BoardThemesScreen/SoundPreferencesScreen fell
    // through to the file's default-deny catch-all and was silently (or
    // visibly, depending on the call site) rejected - none of these
    // settings could ever actually persist.
    match /user_preferences/{userId} {
      allow read, write: if isOwner(userId);

      match /sound/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ============================================
    // Puzzle Content (PuzzleService.getDailyChallenge/getPuzzleById/getPuzzlesByRating)
    // ============================================
    // Curated/admin-authored content, same pattern as season_challenges/
    // tsumeGoProblems - no client ever writes here. Had no rule at all
    // before this, so the read side of the whole puzzle feature (one of
    // this app's two headline features) was rejected by the file's
    // default-deny catch-all in production - PuzzleScreen could never
    // actually load a puzzle or the daily challenge, even though
    // user_puzzle_results (the attempt-recording side) already had its
    // own rule.
    match /puzzles/{puzzleId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /daily_challenges/{challengeId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ============================================
    // Puzzle Attempt History (PuzzleService.recordPuzzleAttempt)
    // ============================================
    // Not nested under users/{uid} - keyed by its own composite id
    // ('${uid}_${puzzleId}_${timestamp}'), one immutable doc per attempt.
    // Previously had no rule at all, so every real attempt write was
    // silently rejected by the default-deny catch-all below (the caller
    // swallows the error - see puzzle_screen.dart's _recordAttempt).
    match /user_puzzle_results/{resultId} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // ============================================
    // Tournaments Collection
    // ============================================
    // `Tournament`/`TournamentParticipant`/`TournamentMatch` are
    // `package:komovia_core`'s shared shapes — see `phase_k_models.dart`'s
    // doc comment on the models these replaced.
    match /tournaments/{tournamentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn() && (
        // Organizer: any field (status, participantUids after a bracket is
        // regenerated, etc.)
        resource.data.createdBy == request.auth.uid ||
        // Any signed-in user may append only themselves to participantUids
        // (registerParticipant).
        (onlyChanged(['participantUids']) &&
         request.resource.data.participantUids == resource.data.participantUids.concat([request.auth.uid]))
      );
      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;

      match /participants/{participantUid} {
        allow read: if isSignedIn();
        // registerParticipant writes the caller's own participant doc,
        // inside the same transaction as the tournament's participantUids
        // update above.
        allow create: if isOwner(participantUid);
        // recordMatchResult increments a participant's own wins/losses/
        // points from the match's winner/loser side, not necessarily the
        // participant themselves — restricted to the tournament organizer,
        // who is the one actually calling it (there is no per-match result
        // -reporting flow in this app yet, unlike sibling apps' PvpGame
        // -backed tournaments). This used to ALSO allow isOwner(participantUid)
        // with no field restriction at all - but nothing in the app ever
        // has a participant update their own doc after registering (only
        // recordMatchResult's organizer-only transaction ever calls
        // update() on this collection), so that branch was pure
        // unguarded self-forgery: any participant could directly set
        // their own wins/losses/points to whatever they liked and top
        // getStandings' ranking, which orders purely by these
        // self-reportable fields with no other validation. Dropped
        // entirely rather than narrowed to specific fields, since no
        // legitimate self-update case exists to carve out.
        allow update: if isSignedIn() &&
          get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.createdBy == request.auth.uid;
        allow delete: if isOwner(participantUid);
      }

      match /matches/{matchId} {
        allow read: if isSignedIn();
        // Bracket generation and result recording are both currently done
        // by the organizer (see tournament_service.dart — this app has no
        // PvpGame-backed per-match result flow yet, unlike sibling apps).
        // Previously this was a blanket `allow write` (covering create,
        // update, AND delete) with no shape constraint at all - not a
        // cross-user forgery hole (still organizer-only), but it let even
        // a legitimate organizer's own buggy bracket-regeneration code
        // silently wipe or rewrite match history (scores, player
        // assignments, winner) with nothing to catch it. tournament_service.dart
        // never actually deletes a match doc, so that's dropped entirely;
        // create/update are now restricted to komovia_core's
        // TournamentMatch.toJson() field shape.
        allow create, update: if isSignedIn() &&
          get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.createdBy == request.auth.uid &&
          request.resource.data.keys().hasOnly([
            'id', 'tournamentId', 'player1Uid', 'player1DisplayName',
            'player2Uid', 'player2DisplayName', 'round', 'winnerUid',
            'status', 'gameId', 'scheduledAt', 'completedAt'
          ]);
        allow delete: if false;
      }
    }

    // ============================================
    // Clubs Collection
    // ============================================
    // A lightweight social group (ClubService) — open-read/joinable, no
    // per-club chat or matches. Creation requires memberUids to be exactly
    // [creator]; join/leave are each restricted to appending/removing only
    // the caller's own uid, same self-service idiom as tournaments'
    // participantUids above.
    match /clubs/{clubId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.memberUids == [request.auth.uid];
      allow update: if isSignedIn() && onlyChanged(['memberUids']) && (
        request.resource.data.memberUids == resource.data.memberUids.concat([request.auth.uid]) ||
        request.resource.data.memberUids == resource.data.memberUids.removeAll([request.auth.uid])
      );
      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;
    }

    // ============================================
    // Prize Winnings (TournamentService.distributePrizes)
    // ============================================
    // Not nested under tournaments/{tournamentId} - keyed by userId alone,
    // since it aggregates prize winnings across every tournament a player
    // has placed in. distributePrizes (organizer-only in practice, but
    // not enforceable here without knowing which tournament a given call
    // belongs to) merge-sets another user's totals from the organizer's
    // own client - client-trusted like this app's other self-reported
    // cross-user writes, narrowed to just these two fields.
    match /user_rewards/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Previously had no value bound at all (only a field-shape check),
      // so any signed-in user could set() a stranger's doc to an
      // arbitrary totalPrizeWinnings/tournaments with no real tournament
      // behind it. distributePrizes always *increments* both fields (by
      // a positive prizeAmount, and by exactly 1 for `tournaments`), so
      // the shape check now requires the same - tournaments must rise by
      // exactly 1, and totalPrizeWinnings must rise (never fall) by a
      // bounded amount per call. distributePrizes computes prizeAmount
      // from a tournament's own prizePool, which is itself currently
      // unbounded at tournament creation (a separate, lower-severity gap
      // - closing it would need its own creation-time cap); prizePool
      // also has no real-money backing (purely cosmetic, per
      // distributePrizes' own doc comment), so the cap here is generous
      // rather than tied to any specific currency limit.
      allow create: if isSignedIn() &&
        request.resource.data.keys().hasOnly(['totalPrizeWinnings', 'tournaments']) &&
        request.resource.data.totalPrizeWinnings is int &&
        request.resource.data.totalPrizeWinnings >= 0 &&
        request.resource.data.totalPrizeWinnings <= 1000000 &&
        request.resource.data.tournaments == 1;
      allow update: if isSignedIn() &&
        onlyChanged(['totalPrizeWinnings', 'tournaments']) &&
        request.resource.data.tournaments == prevIntField('tournaments') + 1 &&
        (request.resource.data.totalPrizeWinnings - prevIntField('totalPrizeWinnings')) >= 0 &&
        (request.resource.data.totalPrizeWinnings - prevIntField('totalPrizeWinnings')) <= 1000000;
    }

    // ============================================
    // Online Games Collection (OnlineGameService)
    // ============================================
    // Every real-time PvP game lives at games/{gameId} with a fixed
    // whitePlayerId/blackPlayerId pair; there's no Cloud Function to own
    // match creation or result reporting, so (like this app's tournament
    // rules) it's client-trusted to the two actual participants - neither
    // can touch a game they aren't in, and neither can rewrite who the
    // two players are once the game exists. Without this block every
    // online-game read/write fell through to the file's default-deny
    // rule, since `games` previously had no rule at all.
    match /games/{gameId} {
      function isGameParticipant() {
        return isParticipant([resource.data.whitePlayerId, resource.data.blackPlayerId]);
      }

      function callerIsWhite() {
        return request.auth.uid == resource.data.whitePlayerId;
      }

      // Guards the one-time 'active' -> 'completed' transition that
      // resignGame/acceptDraw/claimDraw/abandonGame/claimAbandonmentForfeit
      // (Dart, OnlineGameService._endGameWithResult) make directly from the
      // client. recordMove's own checkmate/stalemate ending runs inside the
      // recordMove Cloud Function and handleTimeout is a scheduled Cloud
      // Function - both Admin SDK, both bypass these rules entirely - so a
      // client write that sets status to 'completed' is always one of the
      // four self-reported endings this function validates.
      //
      // Previously `status`/`result` carried no constraint at all here
      // (only currentFen/pgn/moves/the clock fields were locked for
      // non-cpu games), so any participant could set
      // `status:'completed'` with any `result`/`resultReason` pair at
      // all - including declaring themselves the winner of their own
      // resignation, or re-ending an already-completed game - and that
      // forged result flowed straight into the otherwise-unrestricted
      // `users/{uid}` cross-user stat update (see that collection's own
      // update rule).
      function gameEndIsValid() {
        let newStatus = request.resource.data.status;
        let result = request.resource.data.result;
        let reason = request.resource.data.resultReason;
        return newStatus != 'completed' ||
          (resource.data.status == 'active' &&
            result in ['white_win', 'black_win', 'draw'] &&
            (
              // Resigning/abandoning player always reports their OWN loss -
              // never the opponent's.
              ((reason == 'resignation' || reason == 'abandonment') &&
                result == (callerIsWhite() ? 'black_win' : 'white_win')) ||
              // A mutual draw: either side may file it, result is fixed.
              (reason in ['draw_agreement', 'draw_claim_threefold', 'draw_claim_fifty_move'] &&
                result == 'draw') ||
              // Forfeit claim always reports the CLAIMANT (caller) as the
              // winner, against the opponent who went silent.
              (reason == 'abandonment_forfeit' &&
                result == (callerIsWhite() ? 'white_win' : 'black_win'))
            ));
      }

      // Only the caller's own takeback request may ever be *set* - a
      // player can clear the field (decline/accept) freely, but can
      // never write someone else's uid into it. Without this, any
      // participant could call
      // `games/{id}.update({takebackRequestedBy: <opponent uid>})`
      // directly (bypassing OnlineGameService.requestTakeback's own
      // canRequestTakeback check entirely, since Firestore rules - not
      // the Dart UI - are the only real enforcement) and then accept
      // their own forged "opponent's" request via respondToTakeback,
      // force-undoing their own last move with no actual opponent
      // consent at all.
      function takebackFieldValid() {
        return unchanged('takebackRequestedBy') ||
          request.resource.data.takebackRequestedBy == null ||
          request.resource.data.takebackRequestedBy == request.auth.uid;
      }

      // Each player may only ever write their OWN activity timestamp,
      // never the opponent's - recordActivity already only ever touches
      // the caller's own field, but without this a participant could
      // otherwise backdate the OPPONENT's timestamp directly to make
      // canClaimAbandonmentForfeit (lib/src/models/online_game.dart)
      // return true immediately and claim a forfeit win against an
      // opponent who is actually still active.
      function activityTimestampsValid() {
        return (unchanged('whiteLastActivityTimestamp') || request.auth.uid == resource.data.whitePlayerId) &&
          (unchanged('blackLastActivityTimestamp') || request.auth.uid == resource.data.blackPlayerId);
      }

      // Spectator mode: any signed-in user may read (and list, via
      // liveGamesProvider's status/type query) a game that is currently
      // "active" and an online PvP match - not a participant-only
      // restriction here, since the whole point is letting a
      // non-participant watch. A completed/matchmaking-status game, or
      // a CPU game (whitePlayerId/blackPlayerId are the literal strings
      // 'player'/'cpu' for those, not real uids, and there is nothing to
      // watch on someone else's device anyway), stays participant-only -
      // except for a short window right after the game ends: without
      // this, the instant a watched game's status flips away from
      // 'active' (set by the ending participant's client, or by the
      // recordMove/handleTimeout Cloud Functions), the already-open
      // realtime listener every spectator holds stops matching this
      // rule and Firestore kills it with permission-denied -
      // SpectatorGameScreen's _buildGameOverBanner (meant to show the
      // win/draw/loss result) could then never actually render; the
      // spectator would just see a generic error instead. Allowing read
      // for one hour past endedAt keeps the listener alive long enough
      // for that banner to render, without granting indefinite public
      // read access to old completed games.
      allow read: if isGameParticipant() ||
        (isSignedIn() && resource.data.type == 'online_pvp' &&
          (resource.data.status == 'active' ||
            (resource.data.endedAt != null &&
              resource.data.endedAt > request.time - duration.value(1, 'h'))));
      allow create: if isSignedIn() &&
        request.auth.uid in [request.resource.data.whitePlayerId, request.resource.data.blackPlayerId];
      // startGame/recordActivity/_endGameWithResult (resign/draw/
      // claimDraw/abandon/forfeit) all update a mix of status/result/
      // timing fields on this doc from whichever participant's action
      // triggered them - never the identity of the two players
      // themselves.
      //
      // currentFen/pgn/moves/lastMoveTimestamp/whiteTimeRemainingMs/
      // blackTimeRemainingMs are deliberately locked from direct client
      // writes for online PvP games specifically (type != 'cpu'): a
      // move's legality - and, since this session's timeout-handling
      // fix, the clock values recordMove/handleTimeout trust as the
      // authoritative source for ending a game on time - can no longer
      // be trusted from the client at all there. chess.js validates
      // moves server-side in the `recordMove` Cloud Function
      // (functions/src/game-validation.js), which is also the only
      // place either clock field is legitimately decremented now
      // (OnlineGameService.updateTimeRemaining/the provider wrapper
      // that called it have zero real callers anywhere in the app -
      // confirmed dead code). Only the Admin SDK (which bypasses these
      // rules entirely) may change these fields for such a game now.
      // Before locking the clock fields too, any participant could call
      // `games/{id}.update({whiteTimeRemainingMs: 999999999})` directly
      // and recordMove's own timeout check would have trusted it,
      // granting unlimited time. CPU games (`cpu_game_provider.dart`,
      // which shares this same `games` collection) have no server-side
      // validation at all - only the human player's own device ever
      // plays either side, and their clock fields are only ever written
      // once at creation anyway - so they're explicitly exempted rather
      // than broken by this rule.
      allow update: if isGameParticipant() &&
        unchanged('whitePlayerId') && unchanged('blackPlayerId') &&
        (resource.data.type == 'cpu' ||
          (unchanged('currentFen') && unchanged('pgn') &&
           unchanged('moves') && unchanged('lastMoveTimestamp') &&
           unchanged('whiteTimeRemainingMs') && unchanged('blackTimeRemainingMs'))) &&
        // CPU games are single-device, self-reported, and never touch
        // another user's stats (whitePlayerId/blackPlayerId are the
        // literal strings 'player'/'cpu') - gameEndIsValid()'s
        // winner/loser shape only matters for real PvP games, where a
        // forged result flows into another real player's onlineRating.
        (resource.data.type == 'cpu' || gameEndIsValid()) &&
        takebackFieldValid() &&
        activityTimestampsValid();
      allow delete: if false;

      match /moves/{moveId} {
        // Written only by the recordMove Cloud Function now (Admin SDK,
        // bypasses these rules) - a client can still read its own game's
        // move history (gameMoveProvider/getGameMoves), but can no longer
        // forge a move record directly.
        function gameParticipants() {
          return [
            get(/databases/$(database)/documents/games/$(gameId)).data.whitePlayerId,
            get(/databases/$(database)/documents/games/$(gameId)).data.blackPlayerId
          ];
        }

        allow read: if isParticipant(gameParticipants());
        allow create, update, delete: if false;
      }
    }

    // ============================================
    // Activity Feed (FriendService.logActivity/getActivityFeed)
    // ============================================
    // Previously uncovered entirely (fell through to the file's
    // default-deny), so FriendsScreen's reachable activity feed tab
    // would have failed to load, and OnlineGameService's post-game
    // logActivity call (writing into BOTH players' friends' feeds once
    // a game ends) would have been rejected. The writer is whichever
    // client's transaction detects game end first, so request.auth.uid
    // is not necessarily the feed owner - but FriendService.logActivity
    // always writes `userId: userId` as the activity's own actor (the
    // one who did the thing being posted about), and only ever fans out
    // to that actor's own accepted friends' feeds. Without a check tying
    // the two together, any signed-in stranger (not just an accepted
    // friend of feedOwnerUid) could `create` a doc here with completely
    // attacker-controlled title/description/metadata and any claimed
    // userId, which feedOwnerUid would see rendered in their own
    // "Friends" activity feed as if a real friend posted it - a stored
    // content-injection/spam vector into a collection the owner trusts.
    // isAcceptedFriendOf() closes this the same way other cross-user
    // writes in this file are narrowed: not to "nobody but the owner"
    // (the actor genuinely isn't the feed owner here), but to "a real,
    // accepted relationship with the feed owner" instead of "anyone
    // signed in at all".
    function isAcceptedFriendOf(ownerUid) {
      return request.auth.uid == request.resource.data.userId &&
        get(/databases/$(database)/documents/users/$(ownerUid)/friends/$(request.auth.uid)).data.status == 'accepted';
    }

    match /activity_feed/{feedOwnerUid} {
      match /feed/{activityId} {
        allow read: if isOwner(feedOwnerUid);
        allow create: if isSignedIn() &&
          request.resource.data.userId is string &&
          isAcceptedFriendOf(feedOwnerUid);
        allow update, delete: if false;
      }
    }

    // ============================================
    // Friend Challenges (FriendChallengeService)
    // ============================================
    // Previously uncovered entirely (fell through to the file's
    // default-deny), so every send/accept/reject/cancel/complete call
    // from FriendsScreen/ChallengesScreen would have been rejected in
    // production. All three collections are client-trusted the same
    // way `games`/`matchmaking_queue` already are, since there's no
    // Cloud Function to arbitrate a challenge's outcome.
    match /friend_challenges/active/list/{challengeId} {
      // Previously a bare `isSignedIn()` read, which in Firestore rules
      // also authorizes `list`/query operations across the whole
      // collection - not just single-document gets. FriendChallengeService.
      // getActiveChallenges/getChallengeHistory ran an unfiltered-by-user
      // `where('status', ...)` query and filtered to the caller's own
      // challenges client-side only, so any signed-in user could bypass
      // the app entirely and query this collection directly to read
      // every pair of users' challenges app-wide (wagerPoints, both
      // display names, timing). Firestore can only validate an OR
      // condition like this against a `list` query whose own filters
      // already constrain one of the two branches to request.auth.uid
      // (a get() of a single doc is always checked per-document and
      // unaffected) - so getActiveChallenges/getChallengeHistory now run
      // two separately-equality-filtered queries (one per uid field)
      // instead of one broader query, each of which satisfies this rule
      // on its own. getPendingChallenges already queried this way.
      allow read: if isSignedIn() &&
        (resource.data.challengerUserId == request.auth.uid ||
         resource.data.challengeeUserId == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.challengerUserId == request.auth.uid &&
        request.resource.data.status == 'pending';
      // Covers accept/reject/cancel (status + respondedAt/gameId) and
      // completeChallengeWithWinner (status + winnerId/completedAt) -
      // either participant may trigger any of these, never a bystander,
      // and the two participants themselves can never change.
      allow update: if isSignedIn() &&
        (resource.data.challengerUserId == request.auth.uid ||
         resource.data.challengeeUserId == request.auth.uid) &&
        unchanged('challengerUserId') &&
        unchanged('challengeeUserId') &&
        onlyChanged(['status', 'respondedAt', 'gameId', 'winnerId', 'completedAt']);
      allow delete: if false;
    }

    match /challenge_streaks/{userId} {
      // Open read: getTopStreaks is a public leaderboard, same pattern
      // as `rankings` below.
      allow read: if isSignedIn();
      // completeChallengeWithWinner writes BOTH the winner's and the
      // loser's streak doc in one transaction, so this can't be
      // owner-restricted - whichever participant's client runs the
      // transaction must be able to write the other player's doc too,
      // same client-trusted pattern as `users/{userId}`'s rating/stat
      // fields. Unlike that doc's update rule, this used to have NO
      // field restriction at all (a bare `write`, not scoped to
      // specific fields) - any signed-in user could `set()` a
      // stranger's streak doc to any shape at all with arbitrary extra
      // fields, directly defacing (or inflating) the public
      // getTopStreaks leaderboard with no relationship to that victim
      // required whatsoever. completeChallengeWithWinner's own
      // transaction.set() always writes exactly these 7 fields with
      // these types, so this now requires the same shape rather than
      // accepting anything. Shape alone still let a caller `set()` any
      // other player's doc straight to an arbitrary large streak with no
      // real challenge played, so the win/loss counters are additionally
      // bounded to the +1-per-write delta completeChallengeWithWinner's
      // own transaction always applies, and currentStreak may only
      // advance by 1 (a win) or reset to 0 (a loss) - never jump to an
      // arbitrary number.
      allow write: if isSignedIn() &&
        request.resource.data.userId == userId &&
        request.resource.data.keys().hasOnly([
          'userId', 'currentStreak', 'bestStreak',
          'totalChallengesWon', 'totalChallengesLost',
          'winRate', 'streakStartDate'
        ]) &&
        request.resource.data.currentStreak is int &&
        request.resource.data.currentStreak >= 0 &&
        request.resource.data.bestStreak is int &&
        request.resource.data.bestStreak >= 0 &&
        request.resource.data.totalChallengesWon is int &&
        request.resource.data.totalChallengesWon >= 0 &&
        request.resource.data.totalChallengesLost is int &&
        request.resource.data.totalChallengesLost >= 0 &&
        request.resource.data.totalChallengesWon - prevIntField('totalChallengesWon') <= 1 &&
        request.resource.data.totalChallengesLost - prevIntField('totalChallengesLost') <= 1 &&
        (request.resource.data.currentStreak == 0 ||
         request.resource.data.currentStreak == prevIntField('currentStreak') + 1) &&
        request.resource.data.bestStreak >= prevIntField('bestStreak') &&
        // winRate/streakStartDate had no type/range check at all - every
        // other field here is validated, but these two were left open,
        // so a legitimate participant (still gated by the checks above;
        // this isn't a cross-user forgery hole) could otherwise write
        // garbage like a string or a huge negative number into winRate,
        // which getTopStreaks renders straight onto the public
        // leaderboard. ChallengeService.completeChallengeWithWinner
        // always writes winRate as wins/total (a 0-1 fraction) and
        // streakStartDate as a real Timestamp (serverTimestamp() on
        // first write, or the existing value preserved thereafter).
        request.resource.data.winRate is number &&
        request.resource.data.winRate >= 0 &&
        request.resource.data.winRate <= 1 &&
        request.resource.data.streakStartDate is timestamp;
    }

    match /challenge_results/{resultId} {
      // Open read: getHeadToHeadStats queries by arbitrary winner/loser
      // pairs, not just the caller's own matches.
      allow read: if isSignedIn();
      // Previously only checked winnerId/loserId membership with no
      // shape constraint at all - a participant (still gated by that
      // membership check; not a cross-user forgery hole) could write
      // any other field with any value/type, visible to every signed-in
      // user via the open read above and rendered by getHeadToHeadStats.
      // ChallengeService.completeChallengeWithWinner's own
      // transaction.set() always writes exactly these 8 fields with
      // these types/values.
      allow create: if isSignedIn() &&
        request.auth.uid in [request.resource.data.winnerId, request.resource.data.loserId] &&
        request.resource.data.keys().hasOnly([
          'resultId', 'challengeId', 'winnerId', 'loserId',
          'winnerRatingGain', 'loserRatingLoss', 'completedAt',
          'gameMode', 'moveCount'
        ]) &&
        request.resource.data.winnerRatingGain is int &&
        request.resource.data.loserRatingLoss is int &&
        request.resource.data.moveCount is int &&
        request.resource.data.moveCount >= 0 &&
        request.resource.data.gameMode == 'challenge' &&
        request.resource.data.completedAt is timestamp;
      allow update, delete: if false;
    }

    // ============================================
    // Security Audit Collection (監査ログ)
    // ============================================

    match /security_audit/{document=**} {
      // ✅ Admin のみ読み取り可能
      allow read: if isAdmin();

      // ✅ システムのみ追記可能
      allow create: if isSignedIn();

      // ✅ 監査ログは削除・更新禁止 (追記のみ)
      allow update, delete: if false;
    }

    // ============================================
    // Compliance Collection (GDPR)
    // ============================================

    match /compliance/{document=**} {
      // ✅ Admin のみ読み取り可能
      allow read: if isAdmin();

      // ✅ 認証ユーザーは自分のデータリクエストのみ作成可能
      allow create: if isSignedIn();

      // ✅ Admin のみ更新・削除可能
      allow update, delete: if isAdmin();
    }

    // ============================================
    // Achievements Collection
    // ============================================
    // AchievementService's Firestore layout is
    // achievements/{bucket}/{subId}/{achievementId} - bucket is either
    // 'definitions' (subId is always the fixed string 'all', curated
    // content, write: false) or 'user_achievements' (subId is a uid,
    // and only that uid may write their own unlocks).
    match /achievements/{bucket}/{subId}/{achievementId} {
      allow read: if isSignedIn();
      allow write: if bucket == 'user_achievements' && isOwner(subId);
    }

    // ============================================
    // Rankings Collection
    // ============================================

    match /rankings/{document=**} {
      // ✅ 誰でも読み取り可能 (ランキングは公開)
      allow read: if true;

      // ✅ システムのみ書き込み可能
      allow write: if false;
    }

    // ============================================
    // Direct Messages (message_threads/{threadId})
    // ============================================
    // Private 1:1 DMs between friends. threadId is always the two
    // participants' uids sorted and joined (see
    // `DirectMessageService.threadIdFor`), so participantUids is exactly
    // 2 fixed uids that never change for the life of the thread.
    match /message_threads/{threadId} {
      allow read: if isParticipant(resource.data.participantUids);
      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.participantUids &&
        request.resource.data.participantUids.size() == 2;
      // Sending a later message and marking the thread read both go
      // through this same merge-set. Previously any participant could
      // write ANY field here as long as participantUids stayed fixed -
      // with no constraint on lastMessage/lastSenderUid/lastMessageAt/
      // unreadCount, a participant could forge a message preview that
      // was never actually sent (spoofing MessageThreadsScreen's list),
      // reset their own unreadCount to 0 without ever opening the thread,
      // or inflate the other participant's unreadCount arbitrarily.
      // Split into the two legitimate shapes DirectMessageService
      // actually writes: marking read only ever touches the caller's own
      // unreadCount entry (set to 0, the other party's left untouched),
      // and sending a message only ever stamps the caller as
      // lastSenderUid and increments the recipient's own unreadCount by
      // exactly 1 (the sender's own stays put).
      allow update: if isParticipant(resource.data.participantUids) &&
        request.resource.data.participantUids == resource.data.participantUids &&
        (
          (onlyChanged(['unreadCount']) &&
            request.resource.data.unreadCount[request.auth.uid] == 0 &&
            request.resource.data.unreadCount[otherParticipant(resource.data.participantUids, request.auth.uid)] ==
              resource.data.unreadCount[otherParticipant(resource.data.participantUids, request.auth.uid)])
          ||
          (onlyChanged(['lastMessage', 'lastSenderUid', 'lastMessageAt', 'unreadCount', 'participantNames']) &&
            request.resource.data.lastSenderUid == request.auth.uid &&
            request.resource.data.unreadCount[request.auth.uid] == resource.data.unreadCount[request.auth.uid] &&
            request.resource.data.unreadCount[otherParticipant(resource.data.participantUids, request.auth.uid)] ==
              resource.data.unreadCount[otherParticipant(resource.data.participantUids, request.auth.uid)] + 1)
        );
      allow delete: if false;

      match /messages/{messageId} {
        function threadParticipants() {
          return get(/databases/$(database)/documents/message_threads/$(threadId)).data.participantUids;
        }

        allow read: if isParticipant(threadParticipants());
        allow create: if isSignedIn() &&
          request.auth.uid == request.resource.data.fromUid &&
          isParticipant(threadParticipants());
        allow update, delete: if false;
      }
    }

    // ============================================
    // Seasons / Seasonal Events (SeasonalHubScreen)
    // ============================================
    // SeasonalHubScreen (reachable from ProfileScreen's "Seasonal Hub"
    // link) only ever reads these through phase_u_providers.dart's
    // getCurrentSeason/getAllSeasons/getUpcomingSeasons/activeEventsProvider
    // - SeasonManagementService's createSeason/activateSeason/
    // completeSeason/addSeasonalExperience and
    // SeasonalEventService's participateInEvent/withdrawFromEvent/
    // updateEventScore all exist but have no provider wiring anywhere, so
    // there's no reachable write path to allow yet (same "exists but
    // unreachable" situation as several services already documented
    // elsewhere in this app) - write stays false rather than opening it
    // for code nothing calls.
    match /seasons/{seasonId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /player_seasons/{playerId} {
      match /seasons/{seasonId} {
        allow read: if isOwner(playerId);
        allow write: if false;
      }
    }

    match /seasonal_events/{eventId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /player_event_progress/{playerId} {
      match /events/{eventId} {
        allow read: if isOwner(playerId);
        allow write: if false;
      }
    }

    // SeasonalEventService.getEventLeaderboard reads
    // player_event_progress/{eventId}/leaderboard - note the parent id
    // here is an eventId, not a playerId, reusing the same top-level
    // collection name as the block above for an unrelated shape. No
    // reachable caller ever writes this subcollection (same
    // already-documented "always renders empty" bug as
    // getEventLeaderboard itself), so read-only.
    match /player_event_progress/{eventId} {
      match /leaderboard/{entryId} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }

    // ComparisonService (player_comparison_screen.dart): both collections
    // are read-only from every reachable caller - saveHeadToHeadStats has
    // no caller anywhere in the app, so there's no reachable write path
    // to allow yet.
    match /player_matchups/{matchupId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Previously `allow write: if false` unconditionally - harmless
    // while MatchHistoryService.recordMatch had zero real callers
    // anywhere (Match History / comparison screens read this
    // collection but nothing ever wrote to it), but would have
    // rejected the writes once wired up. recordMatch is called from
    // both CpuGameProvider (the signed-in player's own match) and
    // OnlineGameService._endGameWithResult (one match doc per
    // participant, written by whichever client's game-end transaction
    // runs first - not necessarily that player's own client, same
    // cross-user client-trusted pattern as `users/{userId}`'s
    // win/loss/draw stat fields just above).
    match /match_history/{playerId} {
      match /matches/{matchId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.playerId == playerId;
        allow update, delete: if false;
      }
    }

    // SeasonChallengeService (seasonal_hub_screen.dart). season_challenges
    // is curated content, same read-only pattern as seasons/seasonal_events
    // above; player_challenge_progress is the player's own progress, every
    // reachable caller passes the signed-in user's own uid.
    match /season_challenges/{challengeId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /player_challenge_progress/{playerId} {
      match /challenges/{challengeId} {
        allow read: if isSignedIn();
        // Cross-user: SeasonChallengeService.updateChallengeProgress/
        // completeChallenge are now also called from OnlineGameService's
        // game-end flow for BOTH participants - same client-trusted
        // pattern as this app's other self-reported cross-user writes
        // (see users/{userId} above), narrowed to just the progress
        // fields those two methods ever touch.
        // Bounded the same way as the update rule's cross-user branch
        // below - previously this had no bound at all on the initial
        // currentProgress value, so any signed-in user could `create`
        // another player's progress doc directly with currentProgress
        // already at or past targetProgress and isCompleted: true,
        // instantly completing a stranger's challenge in one write (the
        // same exploit class the update rule's delta-bound was written
        // to close, left open on this sibling create path).
        // recordMetricProgress only ever creates a fresh doc with
        // currentProgress == 1, so this bound matches every real caller.
        allow create: if isSignedIn() &&
          request.resource.data.playerId == playerId &&
          request.resource.data.currentProgress is int &&
          request.resource.data.currentProgress >= 0 &&
          request.resource.data.currentProgress <= 10;
        // The cross-user branch previously had no bound at all on the new
        // currentProgress value, so any signed-in user could call this
        // with any other player's uid as {playerId} and jump
        // currentProgress straight to targetProgress (or any larger
        // number) plus isCompleted: true - completing or corrupting a
        // stranger's seasonal challenge in one write. recordMetricProgress
        // only ever increments currentProgress by a small per-event
        // amount (1 per game/win/draw), so a bounded step matches every
        // real caller and still rejects an attacker jumping straight to
        // completion.
        allow update: if isOwner(playerId) ||
          (isSignedIn() &&
           onlyChanged(['currentProgress', 'isCompleted', 'completedAt', 'updatedAt']) &&
           request.resource.data.currentProgress is int &&
           request.resource.data.currentProgress >= resource.data.currentProgress &&
           request.resource.data.currentProgress - resource.data.currentProgress <= 10);
        allow delete: if isOwner(playerId);
      }
    }

    // ============================================
    // Battle Pass (BattlePassService)
    // ============================================
    // Previously uncovered entirely (fell through to the file's
    // default-deny below), so SeasonalHubScreen's reachable
    // BattlePassProgressCard would have failed to load or update in
    // production. `battle_passes` is curated/admin content (no
    // createBattlePass caller anywhere in the app), same read-only
    // pattern as `seasons`/`seasonal_events` above. `player_battle_passes`
    // is the player's own progress, written only by BattlePassService
    // methods reachable exclusively from the signed-in user's own
    // SeasonalHubScreen (playerId is always `currentUserProvider`'s own
    // uid, never another player's) - note `hasPremiumPass` is therefore
    // client-settable like this app's other self-reported purchase
    // fields (see users/{userId}'s subscriptionActive comment above),
    // since there's no Cloud Function to verify it against a real
    // purchase receipt yet.
    match /battle_passes/{battlePassId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /player_battle_passes/{playerId} {
      match /seasons/{seasonId} {
        allow read, write: if isOwner(playerId);
      }
    }

    // ============================================
    // Security Audit & Public Collections
    // ============================================

    match /translations/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /exchange_rates/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================
    // Matchmaking Queue (MatchmakingService)
    // ============================================
    // Previously uncovered entirely (fell through to the file's
    // default-deny below), so joinQueue's own write would have been
    // rejected in production - a second, independent reason online
    // matchmaking never worked, on top of tryMatch's matching logic
    // itself having been a no-op before this fix. Reads are open to any
    // signed-in user since finding a compatible opponent means scanning
    // every other player's waiting entry, same as this app's open-read
    // pattern for `games`-adjacent discovery data. Updates must still
    // reach the OPPONENT's entry too (MatchmakingService._claimPair
    // sets matchedOpponentId on both sides in one transaction, and the
    // later 'matched' write touches both queue docs again) - but
    // "reaches the opponent's doc" and "any signed-in stranger" are not
    // the same thing. Without the participant check below, any
    // signed-in user (not just the actual matched opponent) could
    // update a stranger's waiting entry to
    // status:'matched'/matchedGameId:<garbage> and disrupt matchmaking
    // for players they have no relationship to at all. A legitimate
    // writer is always either the entry's own owner, or the player
    // tryMatch just claimed/confirmed as its matchedOpponentId (on the
    // FIRST write setting it, matchedOpponentId is in
    // request.resource.data; on the SECOND write - the final 'matched'
    // status - it's unchanged from the already-stored resource.data).
    function isMatchmakingParticipant() {
      return request.auth.uid == resource.data.playerId ||
        request.auth.uid == request.resource.data.matchedOpponentId ||
        request.auth.uid == resource.data.matchedOpponentId;
    }

    match /matchmaking_queue/{queueId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.playerId == request.auth.uid &&
        request.resource.data.status == 'waiting';
      allow update: if isSignedIn() &&
        isMatchmakingParticipant() &&
        unchanged('playerId') &&
        unchanged('currentRating') &&
        unchanged('timeControlType') &&
        onlyChanged(['status', 'matchedOpponentId', 'matchedGameId']) &&
        request.resource.data.status in ['matching', 'matched'];
      allow delete: if isOwner(resource.data.playerId);
    }

    // ============================================
    // Default Deny (セキュリティ第一)
    // ============================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
