# Chess Tactics Master - Environment Configuration Example
# Copy this file to .env and fill in actual values
# .env should NOT be committed to git (add to .gitignore)

# Firebase Configuration
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_APP_ID=your_firebase_app_id_here
FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id_here
FIREBASE_PROJECT_ID=yourwish-chess
FIREBASE_AUTH_DOMAIN=yourwish-chess.firebaseapp.com
FIREBASE_DATABASE_URL=https://yourwish-chess.firebaseio.com
FIREBASE_STORAGE_BUCKET=yourwish-chess.appspot.com

# Platform-Specific
FIREBASE_IOS_BUNDLE_ID=com.yourwish.chess
FIREBASE_ANDROID_PACKAGE_NAME=com.yourwish.chess

# Development Configuration
ENABLE_DEBUG_LOGS=true
ENABLE_MOCK_DATA=false

# Feature Flags (Development Only)
ENABLE_DEV_MENU=true
SKIP_ONBOARDING=false

# Analytics
ENABLE_FIREBASE_ANALYTICS=true
ENABLE_CRASHLYTICS=true

# Puzzle Database
PUZZLE_DB_PATH=assets/data/puzzles.db

# Chess Engine
ENABLE_STOCKFISH_WASM=true
STOCKFISH_WASM_PATH=assets/data/stockfish.wasm

# RevenueCat Configuration (Phase E - Paywall)
# Get your API key from: https://dashboard.revenuecat.com/
# This is the Public SDK Key for your app
REVENUEAT_API_KEY=your_revenueat_public_sdk_key_here

# App Environment
APP_ENV=development
